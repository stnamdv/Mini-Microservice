{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDbSettings": {
    "ConnectionString": "mongodb://mongodb:27017",
    "DatabaseName": "ecommerce_orders"
  },
  "KafkaSettings": {
    "BootstrapServers": "kafka:9092",
    "Topic": "order-events"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:3003"
      }
    }
  }
}
